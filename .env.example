# Telegram bot token — get it from @BotFather on Telegram
BOT_TOKEN=paste_your_botfather_token_here

# Optional: only these Telegram user IDs may use the bot. Leave empty for public.
ALLOWED_IDS=

# Pocket Option session (ssid) — enables LIVE OTC candles from the real broker feed.
# Leave empty to keep using the synthetic OTC feed.
# How to capture it:
#   1. Log into pocketoption.com in Chrome
#   2. Press F12 -> Network tab -> filter "WS"
#   3. Click the socket.io websocket row -> "Messages" tab
#   4. Find your outgoing message starting with  42["auth", {...}]
#   5. Copy that whole line into PO_SSID below (keep the 42["auth",...] format)
# Use the DEMO session (isDemo: 1) first — real-account automation can breach ToS.
PO_SSID=
